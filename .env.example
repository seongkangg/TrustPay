# Copy to .env and fill in. Never commit .env.

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO
# Full error detail (tracebacks) goes here; users only see a short message with an ERR-… ref
DEV_LOG_FILE=./logs/dev.log
# Local file for solo dev. For the shared team database, paste the Supabase connection string
# (Project → Connect → "Session pooler", URI) with your DB password filled in, e.g.
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Tables are created on startup with row-level security enabled. Run ONE backend against it.
DATABASE_URL=sqlite:///./trustpay.db
CORS_ORIGINS=http://localhost:5173

# --- LLM ---
# "mock" uses canned fixture responses (default for the demo); "watsonx" calls Granite on
# watsonx.ai; "ollama" calls a model served locally by Ollama (no API key needed).
LLM_MODE=mock
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_MODEL_ID=ibm/granite-3-8b-instruct
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=granite3.3:8b

# --- Gmail intake (read-only) ---
# Emails whose attachment is named invoice.pdf (any case) are fetched, parsed, and processed.
# One-time setup: Google Cloud project → enable Gmail API → OAuth client (Desktop app) →
# save it as secrets/credentials.json → python -m backend.inbox.authorize (writes the token).
INBOX_ENABLED=false
INBOX_POLL_SECONDS=10
INBOX_LOOKBACK_DAYS=30
GMAIL_CREDENTIALS_FILE=./secrets/credentials.json
GMAIL_TOKEN_FILE=./secrets/token.json

# --- Mock enterprise systems ---
# Comma-separated list of mocks to force into failure mode for reliability tests:
# vendor, purchase_order, approval_limit, payment
MOCK_FAILURES=

# --- Frontend ---
# Dev-server proxy target (what Vite forwards API calls to). docker-compose sets http://backend:8000.
API_PROXY_TARGET=http://localhost:8000
# What the browser calls directly. Leave EMPTY in dev (relative URLs go through the proxy);
# set it only for a static production build served away from the API.
VITE_API_BASE_URL=
