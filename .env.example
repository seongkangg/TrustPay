# Copy to .env and fill in. Never commit .env.

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///./trustpay.db
CORS_ORIGINS=http://localhost:5173

# --- LLM ---
# "mock" uses canned fixture responses (default for the demo); "watsonx" calls Granite.
LLM_MODE=mock
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_MODEL_ID=ibm/granite-3-8b-instruct

# --- Mock enterprise systems ---
# Comma-separated list of mocks to force into failure mode for reliability tests:
# vendor, purchase_order, approval_limit, payment
MOCK_FAILURES=

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000
